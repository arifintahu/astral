# Astral Configuration
# Rename this file to .env and uncomment variables to override defaults

# Port to listen on (Default: 8080)
# ASTRAL_PORT=8080

# Authentication credentials (USER:PASS) (Default: admin:secret)
# ASTRAL_AUTH=admin:secret

# Data retention period in days (Default: 7)
# ASTRAL_RETENTION=7

# CPU usage alert threshold percentage (Default: 90)
# ASTRAL_ALERT_CPU=90

# RAM usage alert threshold percentage (Default: 90)
# ASTRAL_ALERT_RAM=90

# Webhook URL for alerts (Optional)
# ASTRAL_WEBHOOK=https://discord.com/api/webhooks/...
